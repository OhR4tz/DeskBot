[Unit]
Description=DeskBot local tracking
After=network.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@PROJECT_DIR@
ExecStart=@PROJECT_DIR@/.venv/bin/deskbot --config @PROJECT_DIR@/configs/deskbot.toml run --enable-servos
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
